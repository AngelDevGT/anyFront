# Copiar este archivo a .env y completar. NO commitear el .env real.

# Connection string del Storage Account (Portal Azure > Access keys).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=storageembutidosany;AccountKey=XXXX;EndpointSuffix=core.windows.net

# Contenedor de imágenes.
CONTAINER_NAME=image-container

# Opcional: contenedor donde respaldar los originales antes de sobreescribir.
# Dejar vacío para NO respaldar (sobreescritura directa en sitio).
BACKUP_CONTAINER=

# Simulación: true = no escribe nada, solo muestra qué haría.
DRY_RUN=true

# Saltar blobs que ya tienen su thumb generado (para re-ejecuciones).
SKIP_EXISTING_THUMBS=true
