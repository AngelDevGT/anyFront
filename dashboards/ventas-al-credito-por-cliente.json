      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Ventas del periodo por estado de pago",
          "description": "Ventas del periodo por estado de pago. **Ventas totales** es el total y equivale a la suma de las otras tres barras. El estado se calcula con los montos pendientes y abonados, así que cubre por igual el pedido y el envío.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bf9e7lr5pdvy8b"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- Ventas del periodo por estado de pago (conteo).\n--\n-- El estado sale de los montos, no del catalogo, para que cubra por igual el\n-- pedido y el envio (una venta puede tener el pedido al credito y el envio\n-- pagado, o al reves):\n--   pendiente = pending_amount + delivery_pending_amount\n--   pagado    = paid_amount    + delivery_paid_amount\n--\n--   Pendientes = debe todo y no ha abonado nada\n--   Abonadas   = debe algo y ya abono algo\n--   Pagadas    = no debe nada\n-- \"Ventas totales\" es el total y equivale a la suma de las otras tres.\nWITH v AS (\n    SELECT\n        (ss.pending_amount + ss.delivery_pending_amount) AS pendiente,\n        (ss.paid_amount + ss.delivery_paid_amount)       AS pagado\n    FROM shop_sale ss\n    WHERE ss.status_id = 52\n      AND ss.customer_id IS NOT NULL\n      AND ss.customer_id::text IN (${cliente:sqlstring})\n      AND $__timeFilter(ss.creation_date AT TIME ZONE 'UTC')\n)\nSELECT t.\"Estado\", t.\"Ventas\"\nFROM (\n    SELECT 1 AS orden, 'Ventas totales' AS \"Estado\", count(*)                                                AS \"Ventas\" FROM v\n    UNION ALL\n    SELECT 2, 'Pendientes', count(*) FILTER (WHERE pendiente > 0 AND pagado <= 0) FROM v\n    UNION ALL\n    SELECT 3, 'Abonadas',   count(*) FILTER (WHERE pendiente > 0 AND pagado > 0)  FROM v\n    UNION ALL\n    SELECT 4, 'Pagadas',    count(*) FILTER (WHERE pendiente <= 0)                FROM v\n) t\nORDER BY t.orden;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
